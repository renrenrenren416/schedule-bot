# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# 開発用: スラッシュコマンドを即時登録するサーバーのID
# 空にするとグローバル登録 (全サーバーで使えるが反映に時間がかかることがある)
GUILD_ID=

# 日時の基準にするタイムゾーン (省略時 Asia/Tokyo)
TIMEZONE=Asia/Tokyo

# 前日の何時に通知するか (省略時 21)
NOTIFY_HOUR=21

# 予定データの保存先 (省略時 ./src/data/schedules.json)
DATA_FILE=

# ---- Google カレンダー連携 (使わないなら空のままでOK) ----
# Google Cloud Console で作った OAuth クライアントの ID とシークレット
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# この Bot の Web サーバーに外からアクセスできる URL (末尾の / は不要)
# 開発中: http://localhost:3000 (自分の PC のブラウザからだけ連携できる)
PUBLIC_URL=http://localhost:3000
# Web サーバーのポート (省略時 3000)
PORT=3000
# Google のトークンを暗号化する鍵。次のコマンドで作った値を貼る:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# トークンの保存先 (省略時 ./src/data/tokens.json)
TOKEN_FILE=
